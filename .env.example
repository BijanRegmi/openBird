# Copy to .env (git-ignored). Used by tool/dev.sh and docker compose.
DATABASE_URL=postgres://openbird:openbird@localhost:54329/openbird?sslmode=disable
# 32 random bytes, base64: openssl rand -base64 32
MASTER_KEY=
PORT=8080
# fs (local disk, served by the server), s3 (any S3-compatible store) or
# azure (Azure Blob Storage)
STORAGE=fs
STORAGE_DIR=data/storage
# STORAGE=s3
# S3_ENDPOINT=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_ACCESS_KEY=openbird
# S3_SECRET_KEY=openbird-secret
# S3_BUCKET=openbird
# S3_REGION=
# STORAGE=azure: a connection string, or AZURE_STORAGE_ACCOUNT and
# AZURE_STORAGE_KEY (with AZURE_STORAGE_ENDPOINT for a non-default endpoint).
# UseDevelopmentStorage=true targets Azurite (docker compose up -d azurite).
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_ENDPOINT=
# AZURE_STORAGE_CONTAINER=openbird
# Optional: the blob endpoint devices download from, when it differs from
# the one the server uses.
# AZURE_STORAGE_PUBLIC_ENDPOINT=
STAGING_DIR=data/staging
# Optional. Origin for the URLs the server hands out. When empty, each
# request's own origin is used (so host CLI and emulator both work).
PUBLIC_URL=
# The built console (cd dashboard && bun run build). Unset to serve only the API.
DASHBOARD_DIR=../dashboard/dist
# Let anyone create a console account (the first account can always sign up).
ALLOW_SIGNUP=false
