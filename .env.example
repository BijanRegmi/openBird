# Copy to .env (git-ignored). Used by tool/dev.sh and docker compose.
DATABASE_URL=postgres://openbird:openbird@localhost:54329/openbird?sslmode=disable
# 32 random bytes, base64: openssl rand -base64 32
MASTER_KEY=
PORT=8080
# fs (local disk, served by the server) or s3 (any S3-compatible store)
STORAGE=fs
STORAGE_DIR=data/storage
STAGING_DIR=data/staging
# Optional. Origin for the URLs the server hands out. When empty, each
# request's own origin is used (so host CLI and emulator both work).
PUBLIC_URL=
# The built console (cd dashboard && bun run build). Unset to serve only the API.
DASHBOARD_DIR=../dashboard/dist
# Let anyone create a console account (the first account can always sign up).
ALLOW_SIGNUP=false
